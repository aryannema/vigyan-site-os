{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cat > *)",
      "Bash(cat >> *)",
      "Bash(find *)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git init*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx shadcn*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(node *)",
      "Bash(python3 -c \"*json*\")",
      "Bash(sudo -u postgres psql -d vigyan_site_os *)",
      "Bash(sudo -u postgres createdb vigyan_site_os*)",
      "Write(*)",
      "Edit(*)",
      "Agent"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo rm*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(sudo -u postgres dropdb*)",
      "Read(*/secret.d/*)",
      "Read(*.env*)",
      "Read(*vigyan-secrets.md*)"
    ]
  }
}
