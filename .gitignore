.agents/*
!.agents/skills/
!.agents/mcp_config.json

# design-system skill source (runtime assets are copied into public/branding/ds/)
YourSite Design System/
skills-lock.json
.vercel
.env*

*.tsbuildinfo

# raw DB dumps (contains real user/auth data — never committed)
.db-backups/

# real secret values (never committed — VIGYAN_SECRETS.md points here, never holds values)
.secrets/

# personal Claude Code permission overrides (not team-shared)
.claude/settings.local.json

# Design-system handoff downloads (extracted into src/, not repo content)
*.zip

# site-bootstrap skill output: an adopter's own company data and branding.
# The skill writes these locally and they must never be committed — what ships
# is the interview, never anyone's answers to it.
seed/local/
brand.config.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/generated/

# secrets/: only SOPS-encrypted vaults are committed; plaintext never.
secrets/*
