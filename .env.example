# =============================================================================
# site-os — environment
# =============================================================================
#
# This file is SHORT on purpose. It holds only what the app needs to boot and
# to build. Everything else — WhatsApp, Razorpay, Meta, Resend, n8n, Notion,
# Gemini, the MCP key, the OTP key — is managed by an administrator in the app
# itself and stored in the database:
#
#     Secrets   /admin/settings/secrets   (public.app_secrets, encrypted)
#     Config    /admin/settings           (public.app_config, not secret)
#
# Those are deliberately NOT listed here. A name in this file reads as
# "something you are supposed to set", and they are not — setting them in env
# is the thing we are migrating away from.
#
# Why it matters: every value that lives here is a value someone must
# transcribe by hand when moving hosts, and a value that can be missing in
# production without anyone noticing. Keeping this list at nine entries is the
# point, not an accident.
#
# Full reasoning: docs/OPS.md §3.
#
# NEVER put a real value in this file. It is committed.
# =============================================================================


# ─── 1. BOOTSTRAP ────────────────────────────────────────────────────────────
# Needed to reach the database. These can never move into the database, because
# they are what gets us there.

# Postgres connection string (self-hosted Supabase on your-vps).
DATABASE_URL=

# Supabase project URL. Public — it is just a hostname.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. PUBLIC BY DESIGN: it ships inside the browser bundle on
# every page load. It is not a password — RLS is what restricts access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. CRITICAL — bypasses RLS entirely. Server only;
# must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts public.app_secrets. CRITICAL. 32 bytes as 64 hex: openssl rand -hex 32
# It decrypts that table, so it cannot be stored in it. Rotating it makes every
# existing secret undecryptable — there is no recovery from a lost key.
CONFIG_ENCRYPTION_KEY=

# Encrypts the 15-day account-deletion grace snapshots. Same generation, same
# no-recovery rule.
ACCOUNT_DELETION_ENCRYPTION_KEY=

# Key ROTATION (migration 043). Both optional until you rotate.
#
# Ciphertext carries its key version, so several keys can be live at once —
# which is the only way rotation is possible. With a single key, changing it
# makes every existing row undecryptable instantly, so in practice nobody
# rotates and the key lives for ever. That is the real risk, not the algorithm.
#
# To rotate:
#   1. openssl rand -hex 32  ->  CONFIG_ENCRYPTION_KEY_V2
#   2. CONFIG_ENCRYPTION_KEY_CURRENT=2   (new writes use v2)
#   3. Run the rotation from /admin/settings/secrets — it re-encrypts every
#      stored value onto v2 and records who ran it and how many rows moved.
#   4. ONLY when the version report shows nothing left on v1, remove
#      CONFIG_ENCRYPTION_KEY. Removing it early makes those rows unreadable
#      for ever — there is no recovery.
CONFIG_ENCRYPTION_KEY_V2=
CONFIG_ENCRYPTION_KEY_CURRENT=

# SEED ONLY — not the admin list. Comma-separated addresses that are granted the
# admin role on FIRST sign-in. Every administrator after that is added at
# /admin/users. This stays in env because it is the break-glass path: a value
# stored in the database cannot be used to regain access to that database.
BOOTSTRAP_ADMIN_EMAILS=


# ─── 2. BUILD ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is compiled into the browser bundle at build time. Changing one
# in Coolify and restarting does nothing — it needs a redeploy.

# Google Analytics 4 measurement ID. Optional; leave blank to disable.
NEXT_PUBLIC_GA4_ID=

# Razorpay publishable key id. Required only once checkout is live. The matching
# SECRET is not here — it is set at /admin/settings/secrets.
NEXT_PUBLIC_RAZORPAY_KEY_ID=


# ─── 3. INFRASTRUCTURE-COUPLED ───────────────────────────────────────────────
# Stays in env because its other half lives somewhere only an operator can
# reach. Moving it into the admin panel would let someone rotate one side of a
# pair while the other side keeps sending the old value.

# Authorises the scheduled-task routes (/api/cron/*). The SAME value is set on
# Coolify's Scheduled Tasks as an `Authorization: Bearer <value>` header. Change
# it in both places in one sitting, or every cron run starts returning 401 with
# nothing in the app able to correct it.
CRON_SECRET=


# ─── 3. LOCAL DEVELOPMENT ONLY ───────────────────────────────────────────────

# Attributes admin writes to a real auth.users row when there is no session,
# for local scripts and tests. Leave UNSET in production — the write path
# raises rather than attributing an action to nobody.
ADMIN_ACTOR=


# ─── Not set here ────────────────────────────────────────────────────────────
# NODE_ENV                 set by Node itself
# NIXPACKS_NODE_VERSION    set in Coolify; read by Nixpacks (its build system),
#                          never by application code
# COOLIFY_API_TOKEN        operator tooling, not the app. Lives in
#                          .secrets/coolify.token (mode 600, gitignored) and is
#                          used only to talk to Coolify's own API.
