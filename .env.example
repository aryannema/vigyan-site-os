# vigyan-site-os — environment
#
# Copy to .env.local and fill in. Nothing here has a safe default; the app will
# not boot without DATABASE_URL, and the MCP route will refuse writes without
# MCP_SERVICE_ACTOR.
#
# See SETUP.md for where each credential comes from.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Every permission check runs here, so this is the
# one value the app genuinely cannot start without.
DATABASE_URL=postgresql://user:password@localhost:5432/vigyan_site_os

# ── Admin identity ───────────────────────────────────────────────────────────
# There is no auth layer yet (see BLOCKERS.md §3). Until there is, /admin/*
# acts as this identity: a uuid, or the email of an auth.users row.
#
# This is why the README says not to expose /admin/* to the internet — anyone
# who reaches it *is* this actor.
ADMIN_ACTOR=

# Comma-separated emails granted the admin role on first run.
BOOTSTRAP_ADMIN_EMAILS=

# ── MCP endpoint (POST /api/mcp) ─────────────────────────────────────────────
# Bearer token a client presents to call MCP tools. Generate a long random
# value; treat it like a password.
MCP_SECRET_KEY=

# A bearer token is not an identity the database can authorize, so the token is
# mapped to a backing identity whose ROLE decides what the token may do. Give
# this actor the narrowest role that works — an agent with blog:edit but not
# blog:publish can draft posts it cannot ship.
MCP_SERVICE_ACTOR=

# ── Supabase (optional) ──────────────────────────────────────────────────────
# Only needed if you use Supabase Storage for the media library. Leave blank to
# run against plain Postgres without uploads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS — never expose it to the browser and never
# commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
